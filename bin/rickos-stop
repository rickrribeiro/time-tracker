#!/usr/bin/env bash
# Desliga o servidor iniciado por rickos-web / rickos-desktop.
# (O servidor embutido do TimeTracker.app desliga sozinho ao sair do app.)
set -uo pipefail
# shellcheck source=bin/_server.sh
source "$(dirname "${BASH_SOURCE[0]}")/_server.sh"

stopped=0
if [ -f "$PID_FILE" ]; then
  pid="$(awk '{print $1}' "$PID_FILE")"
  if ps -p "$pid" -o command= 2>/dev/null | grep -q "dist-server/main.js"; then
    kill "$pid" && stopped=1
  fi
  rm -f "$PID_FILE"
fi

# Fallback: a standalone server on the port that we didn't record.
if [ "$stopped" = 0 ]; then
  for pid in $(lsof -ti "tcp:${PORT}" -sTCP:LISTEN 2>/dev/null); do
    if ps -p "$pid" -o command= | grep -q "dist-server/main.js"; then
      kill "$pid" && stopped=1
    fi
  done
fi

if [ "$stopped" = 1 ]; then
  echo "✓ servidor desligado"
elif server_up; then
  echo "• o servidor em ${URL} pertence ao TimeTracker.app ou ao npm run dev — feche-o por lá"
else
  echo "• nenhum servidor rodando"
fi
