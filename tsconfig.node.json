{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "electron-vite/node",
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "electron.vite.config.*",
    "vite.web.config.*",
    "electron/**/*",
    "server/**/*",
    "scripts/**/*",
    "shared/**/*"
  ]
}
