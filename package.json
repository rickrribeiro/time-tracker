{
  "name": "time-tracker",
  "version": "1.0.0",
  "description": "RickOS — sistema pessoal local-first (desktop Electron + web/celular)",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "concurrently -k -n server,web -c green,cyan \"tsx watch server/main.ts\" \"vite --config vite.web.config.ts\"",
    "build": "tsc && electron-vite build",
    "build:web": "vite build --config vite.web.config.ts && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --target=node18 --packages=external --format=cjs --outfile=dist-server/main.js",
    "start": "node dist-server/main.js",
    "preview": "electron-vite preview",
    "screenshots": "node scripts/screenshots.mjs",
    "app:build": "npm run build && electron-builder --mac --dir",
    "app:install": "bash bin/install-app.sh",
    "desktop": "bash bin/rickos-desktop",
    "web": "bash bin/rickos-web",
    "stop": "bash bin/rickos-stop",
    "chat-agent": "node bin/rickos-chat-agent.mjs",
    "test": "tsx --test server/flights/__tests__/*.test.ts server/chats/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.29.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pluggy-connect": "^2.12.0",
    "sql.js": "^1.12.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^20.11.20",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.6",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.timetracker.app",
    "productName": "TimeTracker",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist-electron",
      "dist"
    ],
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": null
    }
  }
}
